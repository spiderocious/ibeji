{
  "name": "ibeji-app",
  "version": "0.1.3",
  "private": true,
  "description": "Ìbejì — the companion window. A client of the daemon's local HTTP API.",
  "main": "out/main/main.js",
  "scripts": {
    "sync-ds": "./scripts/sync-design-system.sh",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "smoke": "npm run build && ELECTRON_RUN_AS_NODE= ./node_modules/electron/dist/Electron.app/Contents/MacOS/Electron test/smoke.js",
    "dist": "npm run dist:arm64 && npm run dist:x64",
    "dist:arm64": "node scripts/build-binaries.mjs arm64 && npm run build && electron-builder --mac --arm64 --publish never && node scripts/verify-dmg.mjs arm64",
    "dist:x64": "node scripts/build-binaries.mjs amd64 && npm run build && electron-builder --mac --x64 --publish never && node scripts/verify-dmg.mjs x64",
    "modal-check": "npm run build && ELECTRON_RUN_AS_NODE= ./node_modules/electron/dist/Electron.app/Contents/MacOS/Electron test/modal-check.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "typescript": "^7.0.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ibeji.app",
    "productName": "Ibeji",
    "copyright": "Ìbejì",
    "directories": {
      "output": "../dist",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../bin",
        "to": "bin",
        "filter": [
          "ibeji",
          "ibeji-daemon",
          "ibeji-mcp"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Ìbejì ${version}",
      "icon": "assets/icon.icns"
    },
    "afterSign": "scripts/adhoc-sign.cjs"
  }
}
