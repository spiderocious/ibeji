{
  "name": "ibeji-app",
  "version": "0.1.0",
  "private": true,
  "description": "\u00ccbej\u00ec \u2014 the companion window. A client of the daemon's local HTTP API.",
  "main": "out/main/main.js",
  "scripts": {
    "sync-ds": "./scripts/sync-design-system.sh",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "smoke": "npm run build && ELECTRON_RUN_AS_NODE= ./node_modules/electron/dist/Electron.app/Contents/MacOS/Electron test/smoke.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "typescript": "^7.0.2"
  }
}
